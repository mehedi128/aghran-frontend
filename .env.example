# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Sheets Webhook URL (Main Site)
VITE_GOOGLE_SHEETS_URL=""

# Dedicated Google Sheets Webhook URL for Nokshi Pitha Landing Page
VITE_NOKSHI_GOOGLE_SHEETS_URL=""

# Dedicated Google Sheets Webhook URL for Chaler Gura Landing Page
VITE_CHALER_GURA_GOOGLE_SHEETS_URL=""

# --- Server-only secrets (Vercel env vars, used by /api functions) ---
# NEVER prefix these with VITE_: VITE_ variables are bundled into the public browser JS.

# Textbee SMS Gateway (sends from your GP SIM via Textbee Android App) -> api/notify-order.js
TEXTBEE_API_KEY=""
TEXTBEE_DEVICE_ID=""
TEXTBEE_SIM_SUBSCRIPTION_ID="3"
STORE_HELPLINE=""

# Telegram order notifications -> api/notify-order.js
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Meta Conversions API token -> api/capi.js
FB_CAPI_TOKEN=""

# Upstash Redis (added automatically by the Vercel Upstash integration) -> api/order-number.js
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
